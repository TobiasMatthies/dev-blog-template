{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "docusaurus start",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/",
      "program": "node_modules/.bin/docusaurus",
      "args": ["start"],
      "nodeVersionHint": 18
    },
    {
      "type": "node",
      "request": "launch",
      "name": "docusaurus build",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/",
      "program": "node_modules/.bin/docusaurus",
      "args": ["build"],
      "nodeVersionHint": 18
    },
    {
      "type": "node",
      "request": "launch",
      "name": "code-tabs",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/docusaurus-remark-plugin-code-tabs",
      "program": "node_modules/.bin/jest",
      "args": [""]
    }
  ]
}
